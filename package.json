{
  "name": "musicdock-mini",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "node scripts/check-browser.mjs",
    "check": "npm run typecheck && npm test && npm run build && npm run package && npm run test:browser",
    "dev": "node scripts/serve.mjs",
    "package": "powershell -NoProfile -File scripts/package.ps1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
