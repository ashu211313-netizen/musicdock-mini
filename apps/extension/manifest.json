{
  "manifest_version": 3,
  "name": "MusicDock Mini (仮称)",
  "version": "2.0.2",
  "minimum_chrome_version": "116",
  "description": "YouTube Musicを小さな最前面ウィンドウで操作する非公式ミニプレイヤー。",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ]
}
